# Learnxt Multi-AI — copy this file to .env and insert your own secret keys.
# Configure any ONE provider to begin; the others are optional.
# NEVER put keys into public/app.js or upload .env to GitHub.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_MODEL=gpt-4.1-mini

PORT=3000
# HOST=127.0.0.1
